# Copy to .env:  cp .env.example .env
# Never commit .env.

# "development" or "production". Production refuses to start without SECRET_KEY.
QUICKFIX_ENV=development

# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# In development, if this is empty, a key is created once in instance/.secret_key
SECRET_KEY=

# Default is SQLite in instance/quickfix.db. Example Postgres URL for later:
# DATABASE_URL=postgresql+psycopg://user:pass@host/quickfix
DATABASE_URL=

# Local port (change if 5000 is taken, e.g. by macOS AirPlay Receiver)
PORT=5001

# Set to 1 only when served over HTTPS (production)
SESSION_COOKIE_SECURE=0

# Shown on the Support page. Leave empty until you have a real address.
SUPPORT_EMAIL=

# Rate limiter storage (use redis://... in production, memory:// is per-process)
RATELIMIT_STORAGE_URI=memory://
